# App-owned Google OAuth Desktop client. Create once in Google Cloud Console.
# Users never paste these — they only click Connect Google in Settings.
# Redirect URI used by IM Review: http://127.0.0.1:17320
# Client secret is required by Google's token endpoint for Desktop clients.
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_CLIENT_SECRET=
